#!/bin/sh
# 相当于 OpenWrt 的 rcS：boot 时按顺序跑 /etc/rc.d/S??*（参数 boot），shutdown 时跑 K??*（参数 shutdown）。
# 由 openclash-rc.service 在 OpenWrt 视图里调用；上游 init 脚本靠 rc.common 交给 procd 托管。
case $1 in
	boot) p=S ;;
	shutdown) p=K ;;
	*) echo "用法：$0 boot|shutdown" >&2; exit 1 ;;
esac
# procd 连上 ubus 后才有 service 对象
ubus -t 30 wait_for service || { echo "procd 没有就绪" >&2; exit 1; }
# 旁路由/网关要转发（OpenWrt 开机时由 sysctl 脚本打开）
[ "$1" = boot ] && sysctl -qw net.ipv4.ip_forward=1
# 宿主防火墙（firewalld/ufw）放行局域网访问和转发，端口按当前配置
[ "$1" = boot ] && /opt/openclash/rt/sbin/openclash-hostfw apply
for s in /etc/rc.d/$p??*; do
	[ -x "$s" ] && "$s" "$1"
done
exit 0
