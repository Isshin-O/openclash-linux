[Unit]
Description=OpenClash ubus message bus (ubusd)

[Service]
RuntimeDirectory=ubus
ExecStart=/opt/openclash/rt/sbin/ubusd -s /run/ubus/ubus.sock
# 等 socket 出现再算启动完成，rpcd 才能连上
ExecStartPost=/bin/sh -c 'for i in $$(seq 50); do [ -S /run/ubus/ubus.sock ] && exit 0; sleep 0.1; done; exit 1'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
