#!/opt/openclash/rt/bin/ucode -S
// openclash-linux：替换 luci-mod-status 的同名脚本（原版调用 OpenWrt 的 logread）。
// 读 journald，按 OpenWrt logread 的格式输出「日期 设施.级别 标识[PID]: 内容」，
// 系统日志页的设施/级别筛选靠的就是这个格式。
// ponytail: 只取最近 1000 条（OpenWrt 默认 64KB 环形缓冲也就几百条），要更多改 -n
'use strict';

import { popen } from 'fs';

const fac = [ 'kern', 'user', 'mail', 'daemon', 'auth', 'syslog', 'lpr', 'news', 'uucp', 'cron', 'authpriv', 'ftp',
	'ntp', 'security', 'console', 'cron', 'local0', 'local1', 'local2', 'local3', 'local4', 'local5', 'local6', 'local7' ];
const pri = [ 'emerg', 'alert', 'crit', 'err', 'warn', 'notice', 'info', 'debug' ];
const day = [ 'Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat' ];
const mon = [ 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec' ];

const p = popen('journalctl -q -o json -n 1000 --no-pager '
	+ '--output-fields=PRIORITY,SYSLOG_FACILITY,SYSLOG_IDENTIFIER,_COMM,_PID,MESSAGE');

for (let l = p.read('line'); length(l); l = p.read('line')) {
	let e = json(l);
	let t = localtime(int(+e.__REALTIME_TIMESTAMP / 1000000));
	let msg = e.MESSAGE;

	// 非 UTF-8 的内容 journald 会给字节数组
	if (type(msg) == 'array')
		msg = join('', map(msg, chr));

	printf('%s %s %2d %02d:%02d:%02d %d %s.%s %s%s: %s\n',
		day[t.wday % 7], mon[t.mon - 1], t.mday, t.hour, t.min, t.sec, t.year,
		fac[int(e.SYSLOG_FACILITY ?? 1)] ?? 'user', pri[int(e.PRIORITY ?? 6)] ?? 'info',
		e.SYSLOG_IDENTIFIER ?? e._COMM ?? '?', e._PID ? `[${e._PID}]` : '', msg ?? '');
}

p.close();
